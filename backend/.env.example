# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access -> add "0.0.0.0/0" (Allow access from anywhere) so Vercel serverless functions can connect.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learniee?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_32_character_secret_key
JWT_EXPIRES_IN=7d

# CORS (Optional - backend automatically accepts localhost and *.vercel.app preview domains)
# Add custom domain if deploying frontend on a custom domain:
CLIENT_ORIGIN=https://your-frontend-app.vercel.app,http://localhost:5173

